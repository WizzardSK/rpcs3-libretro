# The "From List" games of the VBlank Frequency option, compiled into the core
# and written to vblank_unlock.txt in the core's folder of the system
# directory when it is not there yet (install_vblank_unlock in
# libretro_core.cpp); the user's copy is never overwritten.
function(libretro_embed_vblank_unlock out_file)
    set(db "${CMAKE_CURRENT_SOURCE_DIR}/vblank_unlock.txt")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${db}")
    file(READ "${db}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(WRITE "${out_file}.tmp"
        "// Generated by embed_vblank_unlock.cmake from vblank_unlock.txt\n"
        "#include <cstddef>\n\n"
        "extern const unsigned char g_libretro_vblank_unlock[] = {${bytes}0};\n"
        "extern const std::size_t g_libretro_vblank_unlock_size = ${size};\n")
    file(COPY_FILE "${out_file}.tmp" "${out_file}" ONLY_IF_DIFFERENT)
endfunction()
